<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="ontology\ex.ttl" />
	  <None Remove="ontology\ext\prov.ttl" />
	  <None Remove="ontology\polyseme.n3" />
	  <None Remove="ontology\polyseme.ttl" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="ontology\ex.ttl" />
	  <EmbeddedResource Include="ontology\ext\prov.ttl">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="ontology\polyseme.n3" />
	  <EmbeddedResource Include="ontology\polyseme.ttl">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="dotNetRdf.Core" Version="3.5.2" />
	  <PackageReference Include="dotNetRdf.Inferencing" Version="3.5.2" />
	  <PackageReference Include="dotNetRdf.Shacl" Version="3.5.2" />
	</ItemGroup>

</Project>
